{
  "name": "@opentui/solid",
  "version": "0.5.11",
  "description": "SolidJS renderer for OpenTUI",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opentui",
    "directory": "packages/solid"
  },
  "module": "index.ts",
  "type": "module",
  "private": true,
  "main": "index.ts",
  "license": "MIT",
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:examples": "bun examples/build.ts",
    "bench:reconciler": "bun scripts/reconciler-benchmark.ts",
    "publish": "bun scripts/publish.ts",
    "test:dist": "bun scripts/test-packed-consumer.ts",
    "test:js:node": "bun scripts/test-node.ts",
    "test": "bun test"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.bun.js",
      "import": "./dist/index.js"
    },
    "./preload": {
      "bun": "./dist/scripts/preload.js",
      "import": "./dist/scripts/preload.node.js"
    },
    "./bun-plugin": {
      "types": "./dist/scripts/solid-plugin.d.ts",
      "bun": "./dist/scripts/solid-plugin.js",
      "import": "./dist/scripts/solid-plugin.node.js"
    },
    "./runtime-plugin-support": {
      "types": "./dist/scripts/runtime-plugin-support.d.ts",
      "bun": "./dist/scripts/runtime-plugin-support.js",
      "import": "./dist/scripts/runtime-plugin-support.node.js"
    },
    "./runtime-plugin-support/configure": {
      "types": "./dist/scripts/runtime-plugin-support-configure.d.ts",
      "bun": "./dist/scripts/runtime-plugin-support-configure.js",
      "import": "./dist/scripts/runtime-plugin-support-configure.node.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    }
  },
  "devDependencies": {
    "@opentui/keymap": "workspace:*",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.4.1",
    "@types/node": "^24.0.0",
    "solid-js": "1.9.12",
    "typescript": "^5"
  },
  "dependencies": {
    "@babel/core": "7.28.0",
    "@babel/preset-typescript": "7.27.1",
    "@opentui/core": "workspace:*",
    "babel-plugin-module-resolver": "5.0.2",
    "babel-preset-solid": "1.9.12",
    "entities": "7.0.1",
    "s-js": "^0.4.9"
  },
  "peerDependencies": {
    "solid-js": "1.9.12"
  }
}
