{
  "name": "@opentui/keymap",
  "version": "0.5.11",
  "description": "Standalone keymap package for OpenTUI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opentui",
    "directory": "packages/keymap"
  },
  "module": "src/index.ts",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./extras": {
      "import": "./dist/src/extras/index.js",
      "types": "./dist/src/extras/index.d.ts"
    },
    "./extras/graph": {
      "import": "./dist/src/extras/graph.js",
      "types": "./dist/src/extras/graph.d.ts"
    },
    "./addons": {
      "import": "./dist/src/addons/index.js",
      "types": "./dist/src/addons/index.d.ts"
    },
    "./addons/opentui": {
      "import": "./dist/src/addons/opentui/index.js",
      "types": "./dist/src/addons/opentui/index.d.ts"
    },
    "./testing": {
      "import": "./dist/src/testing/index.js",
      "types": "./dist/src/testing/index.d.ts"
    },
    "./html": {
      "import": "./dist/src/html.js",
      "types": "./dist/src/html.d.ts"
    },
    "./opentui": {
      "import": "./dist/src/opentui.js",
      "types": "./dist/src/opentui.d.ts"
    },
    "./solid": {
      "import": "./dist/src/solid/index.js",
      "types": "./dist/src/solid/index.d.ts"
    },
    "./runtime-modules": {
      "import": "./dist/src/runtime-modules.js",
      "types": "./dist/src/runtime-modules.d.ts"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "publish": "bun run scripts/publish.ts",
    "test:dist": "bun run scripts/test-packed-consumer.ts",
    "test": "bun run scripts/test.ts"
  },
  "dependencies": {
    "@opentui/core": "workspace:*"
  },
  "peerDependencies": {
    "@opentui/solid": "workspace:*",
    "solid-js": "1.9.12"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentui/solid": "workspace:*",
    "@types/bun": "1.4.1",
    "@types/node": "^24.0.0",
    "solid-js": "1.9.12",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
